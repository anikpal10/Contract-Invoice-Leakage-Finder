# ==============================================================================
# CONTRACT & INVOICE LEAKAGE FINDER - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and fill in the values appropriate for your environment.
# Example:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & METADATA
# ------------------------------------------------------------------------------
# Environment mode: "development", "staging", or "production"
ENVIRONMENT=development
PROJECT_NAME="Contract & Invoice Leakage Finder"
API_V1_STR=/v1

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Default SQLite disk database for zero-dependency local development and testing:
DATABASE_URL=sqlite:///./leakage_finder.db

# Production PostgreSQL database connection string (uncomment for production):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/leakage_finder

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION (JWT)
# ------------------------------------------------------------------------------
# Secret key for signing JSON Web Tokens (JWT). In production, generate a secure random string:
# Run: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-super-secret-key-change-in-production-1234567890
ALGORITHM=HS256

# Access token lifespan in minutes (default: 480 minutes / 8 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Refresh token lifespan in days (default: 7 days)
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# 4. LLM / AI CONFIGURATION (Gemini API or OpenAI API)
# ------------------------------------------------------------------------------
# Active LLM provider: "gemini" or "openai"
# (If left empty, system automatically operates in deterministic offline heuristic mode)
LLM_PROVIDER=gemini

# Google Gemini API Configuration (Recommended)
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI API Configuration (Alternative)
# Obtain an API key from OpenAI Platform: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 5. STORAGE & UPLOAD SETTINGS
# ------------------------------------------------------------------------------
# Storage backend: "local" or "gcs" (Google Cloud Storage)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage/uploads
LOCAL_EXPORT_DIR=./storage/exports

# Google Cloud Storage bucket name (required when STORAGE_BACKEND=gcs)
GCS_BUCKET_NAME=

# Maximum upload file size in megabytes
MAX_FILE_SIZE_MB=25

# ------------------------------------------------------------------------------
# 6. CORS (CROSS-ORIGIN RESOURCE SHARING)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins or JSON array format
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

